    {
      "parameters": {
        "jsCode": "const datos = $input.first().json.data;\n\nconst categorias = Object.keys(datos.top5_categorias_con_mas_atraso);\nconst porcentajes = categorias.map(\n  cat => datos.top5_categorias_con_mas_atraso[cat].porcentaje_atraso\n);\n\nconst chartConfig = {\n  type: \"bar\",\n  data: {\n    labels: categorias,\n    datasets: [\n      {\n        label: \"% de atraso\",\n        data: porcentajes,\n        backgroundColor: \"rgba(220, 53, 69, 0.7)\"\n      }\n    ]\n  },\n  options: {\n    title: {\n      display: true,\n      text: \"Top 5 categorías con más atraso\"\n    },\n    scales: {\n      yAxes: [\n        {\n          ticks: { beginAtZero: true }\n        }\n      ]\n    },\n    plugins: {\n      datalabels: {\n        display: true,\n        color: \"black\",\n        anchor: \"end\",\n        align: \"top\",\n        font: { weight: \"bold\" },\n        formatter: (value) => value + \"%\"\n      }\n    }\n  }\n};\n\nreturn [\n  {\n    json: {\n      chartConfig: chartConfig\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
